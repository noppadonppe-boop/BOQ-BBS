VITE_APP_NAME=my-boq-app
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=my-boq-app
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=my-boq-app.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=my-boq-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Optional secure server-side AI drawing analysis endpoint.
# Keep provider API keys on the server; the browser sends the file plus a Firebase ID token.
VITE_AI_DRAWING_ANALYSIS_ENDPOINT=https://cmg-boq-bbs.web.app/analyse-drawing

# Keep false until the database owner configures engineering-fixture access.
VITE_ENABLE_ENGINEERING_FIXTURES=false
